@model AetherFlow.Models.IndexViewModel
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Account";
    var userEmail = User.Identity.GetUserName();
}

<style>
    :root {
        --af-primary: #0ea5e9;
        --af-primary2: #0284c7;
        --af-soft: #e0f2fe;
        --af-border: #eef2f7;
        --af-text: #0f172a;
        --af-muted: #64748b;
    }

    .m-wrap {
        max-width: 1100px;
        margin: 28px auto;
        padding: 0 15px;
    }

    .m-hero {
        background: linear-gradient(135deg, rgba(14,165,233,.16), rgba(2,132,199,.10));
        border: 1px solid var(--af-border);
        border-radius: 18px;
        padding: 18px 18px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
    }

        .m-hero h1 {
            margin: 0;
            font-size: 26px;
            font-weight: 900;
            color: var(--af-text);
        }

        .m-hero p {
            margin: 6px 0 0;
            color: var(--af-muted);
            font-weight: 600;
        }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #e5e7eb;
        font-weight: 800;
        color: var(--af-text);
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 14px;
        align-items: start;
    }

    .cardx {
        background: #fff;
        border: 1px solid var(--af-border);
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(2,132,199,.06);
        overflow: hidden;
    }

    .cardx-h {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        font-weight: 900;
    }

    .cardx-b {
        padding: 14px 16px;
    }

    .btnx {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 14px;
        border-radius: 12px;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .btn-primary {
        background: linear-gradient(135deg,var(--af-primary),var(--af-primary2));
        color: #fff;
        box-shadow: 0 10px 20px rgba(2,132,199,.18);
    }

    .btn-ghost {
        background: #fff;
        border-color: #e5e7eb;
        color: var(--af-text);
    }

    .row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .kv {
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 8px 12px;
    }

    .k {
        color: var(--af-muted);
        font-weight: 800;
    }

    .v {
        color: var(--af-text);
        font-weight: 800;
    }

    @@media(max-width:900px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .kv {
            grid-template-columns: 130px 1fr;
        }
    }
</style>

<div class="m-wrap">

    <div class="m-hero">
        <div>
            <h1>Account</h1>
            <p>Manage your profile and view your bookings.</p>
        </div>
        <div class="pill">
            @userEmail
        </div>
    </div>

    <div class="grid">

        <div class="cardx">
            <div class="cardx-h">Quick Actions</div>
            <div class="cardx-b">
                <div class="row">
                    <a class="btnx btn-primary" href="@Url.Action("MyBookings","Manage")">My Bookings</a>

                    @if (Model.HasPassword)
                    {
                        <a class="btnx btn-ghost" href="@Url.Action("ChangePassword","Manage")">Change Password</a>
                    }
                    else
                    {
                        <a class="btnx btn-ghost" href="@Url.Action("SetPassword","Manage")">Set Password</a>
                    }

                    <a class="btnx btn-ghost" href="@Url.Action("ManageLogins","Manage")">External Logins</a>
                </div>

                <div style="margin-top:12px;color:var(--af-muted);font-weight:600;">
                    Tip: “My Bookings” shows all completed demo purchases.
                </div>
            </div>
        </div>

        <div class="cardx">
            <div class="cardx-h">Account Overview</div>
            <div class="cardx-b">
                <div class="kv">
                    <div class="k">Signed in as</div>
                    <div class="v">@userEmail</div>

                    <div class="k">Phone</div>
                    <div class="v">@(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Not set")</div>

                    <div class="k">Two-Factor</div>
                    <div class="v">@(Model.TwoFactor ? "Enabled" : "Not enabled")</div>
                </div>

                <div style="margin-top:12px; color:var(--af-muted); font-weight:600;">
                    Your security settings are managed here.
                </div>
            </div>
        </div>

    </div>
</div>
