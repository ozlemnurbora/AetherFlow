@{
    ViewBag.Title = "About";
}

<main class="page-transition">
    <section class="about colorful">
        <div class="container">
            <h2>Our Story</h2>
            <p>
                AetherFlow combines elegant design with smooth performance.
                We focus on clarity, speed, and comfort—from your first search
                to your boarding call.
            </p>
            <div class="values">
                <div class="value-card">
                    <img alt="Feather" src="@Url.Content("~/Content/images/icon-feather.svg")" />
                    <h4>Light by Design</h4>
                    <p>Every interaction feels airy and intuitive.</p>
                </div>
                <div class="value-card">
                    <img alt="Wave" src="@Url.Content("~/Content/images/icon-wave.svg")" />
                    <h4>Flow in Motion</h4>
                    <p>Animations and feedback keep you in-the-know, never in the way.</p>
                </div>
                <div class="value-card">
                    <img alt="Shield" src="@Url.Content("~/Content/images/icon-shield.svg")" />
                    <h4>Secure & Private</h4>
                    <p>Modern standards and best practices baked in.</p>
                </div>
            </div>
        </div>
    </section>
</main>